# ============================================================================
# KitchenStock API - environment template
# Copy to .env and fill in for your environment. Never commit the real .env.
# ============================================================================

# -- service -----------------------------------------------------------------
APP_NAME=KitchenStock API
APP_ENV=development            # development | staging | production
DEBUG=true                     # set false in production (hides API docs)
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api

# -- database (PostgreSQL / Supabase) -----------------------------------------
# Local PostgreSQL:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kitchenstock
#
# Supabase gives three hostnames for the same database. Which one you use
# matters more than it looks:
#
#   Session pooler - use this for the container on Cloudflare. IPv4, and the
#   connection is yours for the whole session, so pooling behaves normally.
#   Find it under Project Settings > Database > Connection string > Session.
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
#   Transaction pooler (port 6543) - for serverless, where each invocation is a
#   fresh process. The app detects port 6543 and turns off prepared statements
#   and its own connection pool, which that mode requires.
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#
#   Direct (db.<ref>.supabase.co:5432) - IPv6 only. Fails on any host without
#   IPv6 egress, which includes a lot of them. Prefer a pooler.
#
# CockroachDB still works if you would rather keep it:
# DATABASE_URL=cockroachdb+psycopg://root@localhost:26257/kitchenstock?sslmode=disable
#
DB_ECHO=false                  # log every SQL statement
DB_POOL_SIZE=5                 # per instance; instances x pool must fit Supabase's limit
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_MAX_RETRIES=5               # retries for serialization failures (40001) and deadlocks (40P01)
DB_STATEMENT_TIMEOUT_MS=30000  # cap on any single statement; 0 disables

# -- authentication -----------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
BCRYPT_ROUNDS=12

# -- CORS ---------------------------------------------------------------------
# Comma-separated origins allowed to call this service (the Next.js frontend).
# In production this is the Vercel domain. Include every domain the browser may
# use - the production one AND any preview deployments you intend to test:
#   CORS_ORIGINS=https://kitchenstock.vercel.app,https://kitchenstock-git-main-you.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -- seeding ------------------------------------------------------------------
SEED_ON_STARTUP=true           # create tables and reference data on boot
SEED_DEMO_DATA=true            # load the demo kitchens/items on an empty database
#
# SEED_DEMO_DATA only fires when the database has no items at all, so it can
# never overwrite real stock. Turn it off once the client starts entering their
# own, so a future empty-database accident does not refill it with cakes.
