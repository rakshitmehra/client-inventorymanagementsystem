# ============================================================================
# KitchenStock frontend - environment template
# Copy to .env.local and adjust. Never commit the real .env.local.
# ============================================================================

# Base URL of the KitchenStock API service, including the /api prefix.
# This is baked into the browser bundle at build time, so it must be a URL the
# user's browser can reach - not a docker-internal hostname.
#
# Named local address (modern browsers send any *.localhost name to your own
# machine, so no hosts-file edit is needed):
#   open http://kitstock.localhost:3000 and use
#   NEXT_PUBLIC_API_URL=http://api.kitstock.localhost:8000/api
# The plain http://localhost:3000 + http://localhost:8000/api still works too.
#
# One address for the site AND the API (recommended): keep the browser on a
# single host and let the web server forward /api to the API service.
#   NEXT_PUBLIC_API_URL=/api
#   API_PROXY_TARGET=http://127.0.0.1:8000      # where the API really runs
# Then sign-in is http://kitstock.localhost:3000/login and its request goes to
# http://kitstock.localhost:3000/api/auth/login. No CORS involved.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Show the one-tap demo sign-in buttons on the login page.
# Default is on, including in production, so a fresh deployment can be tested
# straight away. Set to false once this holds real stock - the buttons put four
# working passwords on a public page.
NEXT_PUBLIC_SHOW_DEMO_LOGINS=true
